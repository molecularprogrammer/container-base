[GRAMMAR]
ELEMENTS:
- TAG: TEXT
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: False
  - TITLE: STATEMENT
    TYPE: String
    REQUIRED: True
- TAG: MILESTONE
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: True
  - TITLE: STATUS
    TYPE: SingleChoice(Planned, Active, AtRisk, InReview, Complete, Cancelled)
    REQUIRED: True
  - TITLE: TITLE
    TYPE: String
    REQUIRED: True
  - TITLE: SAFETY_RELEVANCE
    TYPE: SingleChoice(NotSafetyRelated, SafetyRelated, SafetyCritical)
    REQUIRED: True
  - TITLE: GATE_TYPE
    TYPE: SingleChoice(Delivery, RequirementsReview, DesignReview, ComponentVerification, IntegrationReadiness, SystemVerification, ValidationReview, ComplianceReview, ReleaseAuthorization)
    REQUIRED: True
  - TITLE: PROJECT
    TYPE: String
    REQUIRED: True
  - TITLE: COMPONENT
    TYPE: String
    REQUIRED: True
  - TITLE: SCOPE
    TYPE: String
    REQUIRED: True
  - TITLE: BASELINE
    TYPE: String
    REQUIRED: True
  - TITLE: NEXT_ACTIVITY
    TYPE: String
    REQUIRED: True
  - TITLE: DESCRIPTION
    TYPE: String
    REQUIRED: True
  - TITLE: TARGET_DATE
    TYPE: String
    REQUIRED: False
  - TITLE: EXIT_CRITERIA
    TYPE: String
    REQUIRED: True
  - TITLE: REQUIRED_EVIDENCE
    TYPE: String
    REQUIRED: True
  - TITLE: DEPENDENCIES
    TYPE: String
    REQUIRED: False
  - TITLE: LIMITATIONS
    TYPE: String
    REQUIRED: False
  - TITLE: TAILORING_RATIONALE
    TYPE: String
    REQUIRED: False
  - TITLE: INDEPENDENCE
    TYPE: SingleChoice(None, Peer, IndependentPerson, IndependentOrganization, ExternalAssessor)
    REQUIRED: True
  - TITLE: APPROVAL_AUTHORITY
    TYPE: String
    REQUIRED: True
  - TITLE: APPROVAL
    TYPE: String
    REQUIRED: False
  - TITLE: SYNC_ADAPTER
    TYPE: String
    REQUIRED: False
  - TITLE: EXTERNAL_ENTITY_ID
    TYPE: String
    REQUIRED: False
  - TITLE: EXTERNAL_RELATED_ENTITIES
    TYPE: String
    REQUIRED: False
  - TITLE: PLANNING_CONTAINER
    TYPE: String
    REQUIRED: False
  - TITLE: TAGS
    TYPE: Tag
    REQUIRED: False
  RELATIONS:
  - TYPE: Parent
    ROLE: Includes
  - TYPE: Child
    ROLE: Depends on
  - TYPE: File
    ROLE: Delivered by
