[GRAMMAR]
ELEMENTS:
- TAG: TEXT
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: False
  - TITLE: STATEMENT
    TYPE: String
    REQUIRED: True
- TAG: IMPLEMENTATION
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: True
  - TITLE: STATUS
    TYPE: SingleChoice(Planned, Ready, InProgress, Blocked, Complete, Cancelled)
    REQUIRED: True
  - TITLE: TITLE
    TYPE: String
    REQUIRED: True
  - TITLE: PHASE
    TYPE: SingleChoice(Foundation, Core, EdgeCase, ErrorHandling, Verification, Validation, Completion)
    REQUIRED: True
  - TITLE: TYPE
    TYPE: SingleChoice(Task, TestPlan, TestCase, Verification, Validation)
    REQUIRED: True
  - TITLE: SAFETY_RELEVANCE
    TYPE: SingleChoice(NotSafetyRelated, SafetyRelated, SafetyCritical)
    REQUIRED: True
  - TITLE: INDEPENDENCE
    TYPE: SingleChoice(None, Peer, IndependentPerson, IndependentOrganization, ExternalAssessor)
    REQUIRED: False
  - TITLE: BASELINE
    TYPE: String
    REQUIRED: False
  - TITLE: EVIDENCE
    TYPE: String
    REQUIRED: False
  - TITLE: REVIEWER
    TYPE: String
    REQUIRED: False
  - TITLE: REVIEW_DATE
    TYPE: String
    REQUIRED: False
  - TITLE: STATEMENT
    TYPE: String
    REQUIRED: True
  - TITLE: PREREQUISITES
    TYPE: String
    REQUIRED: False
  - TITLE: OUTPUTS
    TYPE: String
    REQUIRED: False
  - TITLE: TEST_LEVEL
    TYPE: SingleChoice(Unit, Component, Integration, System, Acceptance)
    REQUIRED: False
  - TITLE: TEST_METHOD
    TYPE: SingleChoice(Automated, Manual, Analysis, Inspection, FaultInjection, Simulation)
    REQUIRED: False
  - TITLE: PROCEDURE
    TYPE: String
    REQUIRED: False
  - TITLE: EXPECTED_RESULT
    TYPE: String
    REQUIRED: False
  - TITLE: ACTUAL_RESULT
    TYPE: String
    REQUIRED: False
  - TITLE: RESULT
    TYPE: SingleChoice(Pending, Passed, Failed, Blocked)
    REQUIRED: False
  - TITLE: RATIONALE
    TYPE: String
    REQUIRED: False
  - TITLE: COMMENT
    TYPE: String
    REQUIRED: False
  - TITLE: TAGS
    TYPE: Tag
    REQUIRED: False
  - TITLE: EFFORT_MIN
    TYPE: String
    REQUIRED: False
  - TITLE: EFFORT_LIKELY
    TYPE: String
    REQUIRED: False
  - TITLE: EFFORT_MAX
    TYPE: String
    REQUIRED: False
  RELATIONS:
  - TYPE: Parent
    ROLE: Implements or verifies
  - TYPE: Child
    ROLE: Depends on
  - TYPE: File
    ROLE: Implemented by
