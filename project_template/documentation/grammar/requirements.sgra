[GRAMMAR]
ELEMENTS:
- TAG: TEXT
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: False
  - TITLE: STATEMENT
    TYPE: String
    REQUIRED: True
- TAG: REQUIREMENT
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: True
  - TITLE: STATUS
    TYPE: SingleChoice(Draft, Active, Deprecated, Deleted)
    REQUIRED: True
  - TITLE: TITLE
    TYPE: String
    REQUIRED: True
  - TITLE: TYPE
    TYPE: SingleChoice(REQUIREMENT)
    REQUIRED: True
  - TITLE: CATEGORY
    TYPE: SingleChoice(UserStory, Functional, EdgeCase, Error, Safety)
    REQUIRED: True
  - TITLE: PRIORITY
    TYPE: SingleChoice(Critical, High, Medium, Low)
    REQUIRED: True
  - TITLE: SAFETY_CLASS
    TYPE: SingleChoice(NotSafetyRelated, SafetyRelated, SafetyCritical)
    REQUIRED: False
  - TITLE: OPERATING_MODES
    TYPE: String
    REQUIRED: False
  - TITLE: SAFE_STATE
    TYPE: String
    REQUIRED: False
  - TITLE: RESPONSE_TIME
    TYPE: String
    REQUIRED: False
  - TITLE: INTEGRITY_TARGET
    TYPE: String
    REQUIRED: False
  - TITLE: VERIFICATION_METHOD
    TYPE: String
    REQUIRED: False
  - TITLE: STATEMENT
    TYPE: String
    REQUIRED: True
  - TITLE: RATIONALE
    TYPE: String
    REQUIRED: False
  - TITLE: ACCEPTANCE
    TYPE: String
    REQUIRED: False
  - TITLE: SYNC_ADAPTER
    TYPE: String
    REQUIRED: False
  - TITLE: EXTERNAL_ENTITY_ID
    TYPE: String
    REQUIRED: False
  - TITLE: EXTERNAL_RELATED_ENTITIES
    TYPE: String
    REQUIRED: False
  - TITLE: ASSIGNMENT
    TYPE: String
    REQUIRED: False
  - TITLE: PLANNING_CONTAINER
    TYPE: String
    REQUIRED: False
  - TITLE: TAGS
    TYPE: Tag
    REQUIRED: False
  RELATIONS:
  - TYPE: Parent
    ROLE: Derived from
  - TYPE: File
    ROLE: Implemented by
