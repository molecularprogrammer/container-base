[GRAMMAR]
ELEMENTS:
- TAG: MANUAL
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: True
  - TITLE: STATUS
    TYPE: SingleChoice(Draft, InReview, Active, Deprecated)
    REQUIRED: True
  - TITLE: TITLE
    TYPE: String
    REQUIRED: True
  - TITLE: AUDIENCE
    TYPE: String
    REQUIRED: False
  - TITLE: SCOPE
    TYPE: String
    REQUIRED: True
  - TITLE: PREREQUISITES
    TYPE: String
    REQUIRED: True
  - TITLE: PROCEDURE
    TYPE: String
    REQUIRED: True
  - TITLE: EXPECTED_RESULT
    TYPE: String
    REQUIRED: True
  - TITLE: EVIDENCE
    TYPE: String
    REQUIRED: False
  - TITLE: OWNER
    TYPE: String
    REQUIRED: False
  - TITLE: REVIEWER
    TYPE: String
    REQUIRED: False
  - TITLE: REVIEW_DATE
    TYPE: String
    REQUIRED: False
  - TITLE: TAGS
    TYPE: Tag
    REQUIRED: False
  RELATIONS:
  - TYPE: Parent
    ROLE: Derived from
